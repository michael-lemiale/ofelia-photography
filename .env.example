SMTP_USER=
SMTP_PASS=

# Cloudflare R2 Configuration

# Your Cloudflare account ID (found in R2 dashboard)
R2_ACCOUNT_ID=your_account_id_here

# R2 API credentials (create in Cloudflare dashboard)
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here

# Your R2 bucket name
R2_BUCKET_NAME=your_bucket_name_here

# Public URL for your R2 bucket
# Option 1: Custom domain (recommended) - e.g., https://images.yourdomain.com
# Option 2: R2.dev subdomain - e.g., https://your-bucket.r2.dev
R2_PUBLIC_URL=https://your-bucket.r2.dev
